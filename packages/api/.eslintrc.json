{
  "root": true,
  "extends": ["@p-322/eslint-config"],
  "env": {
    "jest": true
  },
  "rules": {
    "node/no-unpublished-import": [
      "error",
      {
        "allowModules": [
          "@jest/globals",
          "@rdfjs/types",
          "n3",
          "streamify-string"
        ]
      }
    ]
  }
}
